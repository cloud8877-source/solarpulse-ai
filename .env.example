# DeepSeek API key for the SolarPulse copilot (Mastra). Used for dev + CE evals only.
# The public demo artifact runs in offline replay mode and needs no key.
DEEPSEEK_API_KEY=

# Force offline replay mode for the copilot (no external API calls): 1 = on, 0 = off.
SOLAROPS_REPLAY=0

# Copilot model via the Mastra/DeepSeek router. Default: deepseek/deepseek-v4-flash
# (fast + economical). Use deepseek/deepseek-v4-pro for maximum capability.
# SOLAROPS_MODEL=deepseek/deepseek-v4-flash
